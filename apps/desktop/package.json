{
  "name": "@acc/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop UI (Tauri 2 + React). A client of the Core Daemon.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "scene": "tsx scripts/scene.ts",
    "e2e:slice": "node e2e/slice.js",
    "screenshots": "node e2e/screenshots.js",
    "tauri": "tauri",
    "tauri:dev": "node scripts/prepare-sidecar.js && tauri dev",
    "tauri:build": "node scripts/prepare-sidecar.js --release && tauri build"
  },
  "dependencies": {
    "@acc/client": "workspace:*",
    "@acc/protocol": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.63.0",
    "marked": "^18.1.2",
    "motion": "^14.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "vite": "^8.3.5"
  }
