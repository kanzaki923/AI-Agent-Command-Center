{
  "name": "ai-agent-command-center",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:daemon": "pnpm --filter @acc/daemon dev",
    "start:daemon": "pnpm --filter @acc/daemon start",
    "dev:desktop": "node scripts/dev-desktop.js",
    "dev:web": "pnpm --filter @acc/desktop dev",
    "build:desktop": "pnpm --filter @acc/desktop tauri build",
    "acc": "node packages/cli/bin/acc.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel --no-bail typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
